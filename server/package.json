    "./services/aws": "./services/aws/sts.ts",
    "./services/aws/plans": "./services/aws/plans.ts",
    "./services/provider-connections": "./services/provider-connections/index.ts",
    "./validations/provider-connection": "./validations/provider-connection.ts",
    "./services/vercel": "./services/vercel/agent.ts",
    "./services/github": "./services/github/status.ts",
    "./services/deployments": "./services/deployments/index.ts",
    "./services/github/repos": "./services/github/repos.ts",
    "./validations/deployment": "./validations/deployment.ts",
    "./services/github/intent": "./services/github/intent.ts",
    "./services/github/agent": "./services/github/agent.ts",
    "./services/github/analyze": "./services/github/analyze.ts",
    "./services/github/source": "./services/github/source.ts",
    "./services/n8n": "./services/n8n/index.ts",
    "./services/n8n/plans": "./services/n8n/plans.ts",
    "./services/n8n/planner": "./services/n8n/planner.ts",
