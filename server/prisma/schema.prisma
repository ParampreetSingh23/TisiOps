generator client {
  provider            = "prisma-client"
  output              = "../db/generated"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum CloudProvider {
  AWS
  GCP
  AZURE
  DIGITALOCEAN
  HETZNER
  CUSTOM_VPS
}

enum ProviderConnectionStatus {
  PENDING
  CONNECTED
  FAILED
  DISABLED
}

enum CredentialType {
  ACCESS_KEY
  IAM_ROLE
  SERVICE_ACCOUNT
  OAUTH
  CUSTOM
}

enum ChatRole {
  USER
  ASSISTANT
}

enum DeploymentType {
  VERCEL
  N8N
  POSTGRES
  /// A server provisioned in the user's own AWS account with their own credentials.
  AWS_SERVER
}

enum DeploymentProvider {
  TISIOPS_MANAGED_VERCEL
  /// EC2 in the TisiOps-owned AWS account. The user supplies no credentials.
  TISIOPS_MANAGED_AWS
  /// EC2 in the user's own AWS account, using the AWS connection they saved.
  USER_AWS_ACCOUNT
  /// An existing server connected with the user's SSH credential.
  BYOK_SERVER
}

enum DeploymentStatus {
  PREPARING
  RETRYING
  BUILDING
  LIVE
  FAILED
  CANCELLED
  /// Built and deployed, but Vercel Deployment Protection blocks the URL.
  ACCESS_BLOCKED
  /// No real deployment ran — the MVP recorded the approval only.
  PLACEHOLDER

  // Managed-server states. A run moves down this list in order, and the
  // progress screen turns the current one into the highlighted step.
  DRAFT
  PLANNING
  PENDING
  RUNNING
  PROVISIONING_INFRA
  BOOTSTRAPPING_SERVER
  CONFIGURING_N8N
  /// Custom domain chosen, but its A record does not point at the Elastic IP.
  WAITING_FOR_DNS
  CONFIGURING_SSL
  HEALTH_CHECKING
  /// Waiting in the Redis queue for a worker.
  QUEUED
  /// Handler is pushing the build or app out.
  DEPLOYING

  // Paused states. The server still exists and its disk and address are kept;
  // only the compute is off, which is what stops most of the bill.
  STOPPING
  STOPPED
  STARTING
}

enum JobStatus {
  PENDING
  /// Handed to Redis. The Postgres row is still the source of truth — this
  /// only records that a worker has been notified.
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum JobType {
  N8N_MANAGED_SERVER_DEPLOYMENT
  POSTGRES_MANAGED_SERVER_DEPLOYMENT
  VERCEL_DEPLOYMENT
  AWS_APP_DEPLOYMENT
  RETRY_DEPLOYMENT
  REPAIR_DEPLOYMENT
  /// terraform destroy. Destructive and irreversible — the API requires a
  /// typed confirmation before one of these rows is ever written.
  TERRAFORM_DESTROY
  /// Stop the EC2 instance, keeping its disk and Elastic IP.
  SERVER_STOP
  /// Start a stopped EC2 instance again.
  SERVER_START
  /// Delete the Vercel project behind a Vercel deployment.
  VERCEL_DELETE
}

enum RepairPlanStatus {
  DRAFT
  APPROVAL_REQUIRED
  APPROVED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum RepairRiskLevel {
  READ_ONLY
  PLANNING
  EXECUTION
  DESTRUCTIVE
}

enum ServerStatus {
  PROVISIONING
  READY
  FAILED
  TERMINATED
  STOPPING
  STOPPED
  STARTING
  CONNECTED
  VERIFYING
  NEEDS_ATTENTION
  UNREACHABLE
  DISCONNECTED
}

enum TerminalSessionStatus {
  CONNECTING
  CONNECTED
  DISCONNECTED
  FAILED
}

enum MonitoringStatus {
  NOT_INSTALLED
  INSTALLING
  ACTIVE
  FAILED
  DISABLED
  UPGRADING
}

enum ServerRepairStatus {
  DRAFT
  APPROVAL_REQUIRED
  APPROVED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  PLANNED_NOT_IMPLEMENTED
}

/// Pre-execution lifecycle for a staging session. Nothing past PLAN_READY runs
/// on a server yet — this is the foundation that models what the user wants,
/// not the provisioning that will eventually run it.
enum StagingStatus {
  CREATED
  SELECT_SOURCE_TYPE
  SELECT_SOURCE
  ANALYSING
  SOURCE_DISCOVERY_FAILED
  SOURCE_READY
  PLAN_READY
  TARGET_SELECTED
  PLAN_NOT_READY
  READY
  FAILED
  CANCELLED
}

enum StagingSourceType {
  STAGING_SOURCE_SERVER
  STAGING_SOURCE_REPOSITORY
}

enum HostingMode {
  TISIOPS_MANAGED
}

enum DomainMode {
  /// <workspace>.tisiops.app — needs DNS automation that is not enabled yet.
  TISIOPS_SUBDOMAIN
  /// The user points their own A record at the Elastic IP.
  CUSTOM
  /// No domain: n8n answers on the Elastic IP over plain HTTP.
  NONE
}

enum LogLevel {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum EnvTarget {
  PRODUCTION
  PREVIEW
  DEVELOPMENT
}

enum TemplateStatus {
  DRAFT
  VALIDATED
  TESTED
  PUBLISHED
  DISABLED
  ARCHIVED
}

enum TemplateRunnerType {
  DOCKER_COMPOSE_SERVER_RUNNER
  DATABASE_SERVICE_RUNNER
  N8N_MANAGED_SERVER_RUNNER
  CUSTOM_HANDLER
}

/// One row per user per day per model.
///
/// The source of truth for AI spend. Redis holds a per-minute counter for
/// burst control, but it expires in two minutes and may be evicted — anything
/// that decides whether a user has spent their day must be read from here.
model AiUsageDaily {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// UTC calendar day, as yyyy-mm-dd. A string so the unique constraint is a
  /// plain equality check rather than a range scan.
  date   String
  model  String

  messageCount Int @default(0)
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  totalTokens  Int @default(0)
  /// Calls that reached the provider and failed. Counted so a broken key does
  /// not look like quiet usage.
  failedCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date, model])
  @@index([date])
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  connections      CloudProviderConnection[]
  chatSessions     AiChatSession[]
  deployments      Deployment[]
  repairPlans      RepairPlan[]
  agentRuns        AgentRun[]
  servers          Server[]
  serverMonitorings ServerMonitoring[]
  serverMetricSnapshots ServerMetricSnapshot[]
  serverRepairPlans ServerRepairPlan[]
  aiUsage          AiUsageDaily[]
  apiKeys          UserApiKey[]
  aiGatewayUsage   AiUsage[]
  aiGatewayLogs    AiGatewayRequestLog[]
  templates        AdminTemplate[]
  terminalSessions TerminalSession[]
  stagingSessions  StagingSession[]

  @@index([email])
}

model AiProvider {
  id            String   @id @default(cuid())
  providerId    String   @unique
  name          String
  type          String
  baseUrl       String?
  apiKeyEnvName String?
  isEnabled     Boolean  @default(true)
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  models AiModel[]

  @@index([isEnabled])
}

model AiModel {
  id                String   @id @default(cuid())
  modelCode         String   @unique
  displayName       String
  providerId        String
  providerModel     String
  description       String?
  contextWindow     Int?
  inputPricePer1M   Decimal?
  outputPricePer1M  Decimal?
  currency          String   @default("USD")
  isEnabled         Boolean  @default(true)
  isPublic          Boolean  @default(true)
  isDefault         Boolean  @default(false)
  supportsStreaming Boolean  @default(false)
  supportsJson      Boolean  @default(false)
  supportsTools     Boolean  @default(false)
  tags              Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider AiProvider @relation(fields: [providerId], references: [providerId])

  @@index([providerId])
  @@index([isEnabled, isPublic])
}

model UserApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String
  keyHash    String    @unique
  status     String    @default("ACTIVE")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  usage AiUsage[]
  logs  AiGatewayRequestLog[]

  @@index([userId, createdAt])
  @@index([status])
}

model AiUsage {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKeyId      String?
  apiKey        UserApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  source        String
  agentName     String?
  modelCode     String
  providerId    String
  providerModel String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  totalTokens   Int      @default(0)
  estimatedCost Decimal?
  currency      String   @default("USD")
  status        String
  errorCode     String?
  requestId     String?
  deploymentId  String?
  sessionId     String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([modelCode, createdAt])
  @@index([providerId, createdAt])
  @@index([status, createdAt])
}

model AiGatewayRequestLog {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiKeyId     String?
  apiKey       UserApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  requestId    String   @unique
  modelCode    String
  providerId   String
  status       String
  errorCode    String?
  latencyMs    Int?
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model AdminTemplate {
  id             String             @id @default(cuid())
  templateId     String
  name           String
  description    String
  category       String
  tags           String[]
  iconUrl        String?
  coverImageUrl  String?
  yamlContent    String
  parsedManifest Json
  status         TemplateStatus     @default(DRAFT)
  runnerType     TemplateRunnerType?
  version        Int                @default(1)
  createdBy      String
  creator        User               @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([templateId, version])
  @@index([status, updatedAt])
  @@index([templateId, version])
  @@index([createdBy])
}

/// One deployment run, owned by exactly one user. Reads go through
/// services/deployments, which scopes every query by userId.
model Deployment {
  id       String             @id @default(cuid())
  userId   String
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     DeploymentType     @default(VERCEL)
  provider DeploymentProvider @default(TISIOPS_MANAGED_VERCEL)

  appName         String
  /// Empty for deployments that have no repository, such as a managed n8n
  /// server. Defaulted rather than nullable so the Vercel paths, which always
  /// set all three, keep reading plain strings.
  repositoryName  String             @default("")
  repositoryOwner String             @default("")
  repositoryUrl   String?
  branch          String             @default("")
  framework       String?
  /// Folder inside the repository, e.g. "frontend" in a monorepo.
  /// Root Directory sent to Vercel, e.g. "frontend" in a monorepo.
  servicePath     String?
  buildCommand    String?
  startCommand    String?
  /// Empty/null means "let Vercel manage it", which is right for Next.js.
  outputDirectory String?

  status     DeploymentStatus @default(PREPARING)
  /// The public project alias, e.g. https://tisiops-notesapp.vercel.app — this
  /// is the only URL shown to the user.
  previewUrl String?
  /// The unique per-build URL Vercel returns, e.g.
  /// https://tisiops-notesapp-qi49925vt-tisi-ops.vercel.app. Kept for logs and
  /// debugging: Deployment Protection usually makes it unopenable.
  vercelDeploymentUrl String?

  vercelProjectId    String?
  vercelDeploymentId String?
  /// Why a deployment failed, or why it stayed a placeholder.
  statusDetail       String?
  /// Machine-readable failure reason, e.g. GITHUB_BRANCH_NOT_FOUND, so the UI
  /// can offer the right next action rather than parsing a sentence.
  failureCode        String?

  retryCount    Int       @default(0)
  lastRetriedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The address the user opens. Vercel deployments keep using previewUrl;
  /// managed-server deployments set this once a health check passes.
  publicUrl String?
  domain    String?

  /// Which fixed Terraform module ran, e.g. "aws-n8n-server". Recorded so a
  /// deployment can be traced to the exact module, and so a retry cannot land
  /// on a different one.
  template String?
  /// `terraform output -json`, flattened. Infrastructure ids and addresses
  /// only — no credentials, because the module emits none.
  terraformOutputs Json?
  /// Short, safe summary of the last `terraform plan`. Never the full output,
  /// which can name variables.
  planSummary String?
  /// When the user accepted the cost warning for this deployment. Null means
  /// no approval was recorded, which blocks a job from being queued.
  costApprovedAt DateTime?
  /// When the user typed the destroy confirmation. Recorded so a destroy can
  /// be traced to an explicit decision.
  destroyApprovedAt DateTime?

  /// Provisioning key pair for this deployment's server. Generated per
  /// deployment so one leaked key never reaches another user's machine. The
  /// private half is encrypted at rest with the same key as env values and is
  /// never returned by any API, rendered, or logged.
  sshPublicKey           String?
  encryptedSshPrivateKey String?

  logs                 DeploymentLog[]
  environmentVariables DeploymentEnvVar[]
  attempts             DeploymentAttempt[]
  jobs                 DeploymentJob[]
  repairPlans          RepairPlan[]
  agentRuns            AgentRun[]
  servers              Server[]
  n8nConfig            N8nDeploymentConfig?
  postgresConfig       PostgresDeploymentConfig?

  @@index([userId, createdAt])
}

/// Work the API refuses to do inside a request: Terraform runs for minutes and
/// would outlive any HTTP timeout. The API writes the row, hands Redis nothing
/// but this row's id, and returns. `npm run worker` runs it.
///
/// This table is the source of truth. Redis only carries the notification, so
/// losing the queue loses nothing that cannot be re-enqueued from here.
model DeploymentJob {
  id           String     @id @default(cuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  type         JobType    @default(N8N_MANAGED_SERVER_DEPLOYMENT)
  status       JobStatus  @default(PENDING)
  attempts     Int        @default(0)
  /// Validated deployment config. Never holds secrets: n8n's encryption key and
  /// database password are generated in the worker and stored encrypted on
  /// N8nDeploymentConfig instead.
  payloadJson  Json
  errorMessage String?

  /// Claim marker. A worker sets both in the same statement that flips the row
  /// to RUNNING, so two workers cannot take the same job.
  lockedAt   DateTime?
  lockedBy   String?
  startedAt  DateTime?
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs DeploymentLog[]

  @@index([status, createdAt])
  @@index([deploymentId])
}

/// A machine connected to TisiOps or created in AWS by Terraform.
model Server {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deploymentId String?
  deployment   Deployment? @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  name         String      @default("Ubuntu Server")
  provider     String      @default("CUSTOM_VPS")
  region       String?
  instanceType String?

  awsInstanceId      String?
  awsSecurityGroupId String?
  elasticIp          String?
  publicIp           String?
  host               String?
  sshPort            Int         @default(22)
  sshUsername        String?     @default("ubuntu")
  osType             String?     @default("Ubuntu")
  osVersion          String?

  dockerStatus       String?
  sudoStatus         String?
  cpuInfo            String?
  memoryMb           Int?
  diskGb             Int?

  status             ServerStatus @default(VERIFYING)
  credentialsStored  Boolean      @default(false)

  lastCheckedAt      DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  credentials      ServerCredential?
  terminalSessions TerminalSession[]
  serverMonitoring ServerMonitoring?
  metricSnapshot   ServerMetricSnapshot?
  repairPlans      ServerRepairPlan[]
  stagingSessions  StagingSession[]

  @@index([userId, createdAt])
  @@index([deploymentId])
}

/// "Create staging from this production server." The source server is the
/// reference; the plan and status lifecycle record what the user wants. No SSH,
/// no provisioning yet — this is the staging concept, not the staging engine.
model StagingSession {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType StagingSourceType?
  /// The production server this staging set is created from, when sourceType is server.
  sourceServerId String?
  sourceServer   Server? @relation(fields: [sourceServerId], references: [id], onDelete: Cascade)
  /// GitHub full name, e.g. "owner/repo", when sourceType is repository.
  sourceRepositoryId String?
  sourceBranch       String?

  title       String
  status      StagingStatus @default(CREATED)
  /// Staging target, e.g. "new_instance", "same_server", "docker_compose".
  target      String?
  targetLabel String?
  /// Parsed analysis: what the production server runs, what a staging copy
  /// needs. Never contains credentials.
  planJson Json?

  /// Read-only production discovery result: what is actually running on the
  /// source server. Written by the Discovery Worker, never by an HTTP request.
  runtimeJson  Json?
  discoveredAt DateTime?
  discoveryError String?

  /// Code analysis profile for the repository the server runs, when known.
  codeProfileJson Json?
  /// The combined production blueprint (code + runtime + deployment + monitoring).
  blueprintJson Json?
  /// The isolated staging recommendation derived from production.
  stagingJson Json?

  /// Selected target server (for EXISTING_SERVER), and the target choice.
  targetServerId String?
  /// The final staging plan the user reviews and approves.
  finalPlanJson Json?
  /// When the user approved the staging plan. Null until approval.
  approvedAt DateTime?

  sessionId String?
  session   AiChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, sourceServerId])
  @@index([userId, sourceRepositoryId])
}

model TerminalSession {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId         String
  server           Server                @relation(fields: [serverId], references: [id], onDelete: Cascade)
  status           TerminalSessionStatus @default(CONNECTING)
  sessionTokenHash String
  tokenExpiresAt   DateTime
  startedAt        DateTime?
  endedAt          DateTime?
  lastActivityAt   DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([userId, createdAt])
  @@index([serverId, createdAt])
  @@index([sessionTokenHash])
}

model ServerCredential {
  id                  String   @id @default(cuid())
  serverId            String   @unique
  server              Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId              String
  authType            String   @default("key")
  encryptedPrivateKey String?
  encryptedPassword   String?
  encryptedPassphrase String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

/// Monitoring lifecycle state for one connected server. Phase 1 only stores
/// and displays whether monitoring is installed — no install worker, metrics,
/// or agent yet. A server gets exactly one row, which is why serverId is unique.
model ServerMonitoring {
  id      String          @id @default(cuid())
  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId String          @unique
  server  Server          @relation(fields: [serverId], references: [id], onDelete: Cascade)

  status   MonitoringStatus @default(NOT_INSTALLED)
  agentVersion String?
  installPath  String?      @default("/opt/tisiops/monitoring")

  installedAt     DateTime?
  lastHeartbeatAt DateTime?
  lastCheckedAt   DateTime?

  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, serverId])
}

/// One row per server: the latest collected monitoring snapshot. Collection
/// upserts by serverId, so there is no unlimited history yet. Phase 5 only
/// stores the normalized current values — never a raw Prometheus payload.
model ServerMetricSnapshot {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId String @unique
  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  cpuPercent           Float?
  memoryPercent        Float?
  diskPercent          Float?

  dockerStatus         String?
  containerCount       Int      @default(0)
  unhealthyContainers  Int      @default(0)

  lastHeartbeatAt DateTime?
  collectedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, serverId])
}

/// A safe, user-approved server repair plan. The Monitoring Agent flags an
/// issue; this records what a fix would be, requires approval, and only the
/// worker runs a fixed handler afterwards. Never stores commands or credentials.
model ServerRepairPlan {
  id         String            @id @default(cuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId   String
  server     Server            @relation(fields: [serverId], references: [id], onDelete: Cascade)

  issueType       String
  diagnosis       String
  evidenceJson    Json
  actionsJson     Json
  riskLevel       String
  approvalRequired Boolean       @default(true)
  status          ServerRepairStatus @default(APPROVAL_REQUIRED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, serverId, createdAt])
  @@index([status])
}

/// What the user asked for, plus the secrets the worker generated for them.
/// The two secret columns are encrypted with the same key as env-var values
/// and are never returned by any API, rendered, or logged.
model N8nDeploymentConfig {
  id           String     @id @default(cuid())
  deploymentId String     @unique
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  workspaceName String
  adminEmail    String
  timezone      String      @default("Asia/Kolkata")
  region        String      @default("ap-south-1")
  plan          String      @default("STARTER")
  instanceType  String      @default("t3.micro")
  domainMode    DomainMode  @default(NONE)
  domain        String?
  webhookUrl    String?
  databaseType  String      @default("postgresdb")
  hostingMode   HostingMode @default(TISIOPS_MANAGED)

  /// Encrypted at rest. Regenerating either one would lock the user out of
  /// their own credentials, so a retry reuses whatever is already here.
  encryptedEncryptionKey String?
  encryptedDbPassword    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PostgresDeploymentConfig {
  id           String     @id @default(cuid())
  deploymentId String     @unique
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  workspaceName   String
  databaseName    String @default("appdb")
  databaseUser    String @default("tisiops_user")
  postgresVersion String @default("16-alpine")
  region          String @default("ap-south-1")
  plan            String @default("STARTER")
  instanceType    String @default("t3.micro")
  volumeSizeGb    Int    @default(20)
  host            String?
  port            Int    @default(5432)

  encryptedPassword    String?
  encryptedDatabaseUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One deploy or retry run. The Deployment is the logical app; each attempt
/// is a separate execution with its own outcome.
model DeploymentAttempt {
  id            String           @id @default(cuid())
  deploymentId  String
  deployment    Deployment       @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  attemptNumber Int
  status        DeploymentStatus @default(PREPARING)
  errorMessage  String?
  previewUrl    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  logs DeploymentLog[]

  @@unique([deploymentId, attemptNumber])
  @@index([deploymentId, attemptNumber])
}

model DeploymentLog {
  id           String     @id @default(cuid())
  deploymentId String
  deployment   Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  /// Which run produced this line, so a retry timeline can be grouped.
  attemptId    String?
  attempt      DeploymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  /// Set instead of attemptId for worker-driven runs.
  jobId        String?
  job          DeploymentJob?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  level        LogLevel   @default(INFO)
  message      String
  step         String?
  stepStatus   String?
  errorCode    String?
  durationMs   Int?
  traceId      String?
  spanId       String?
  metadataJson Json?
  createdAt    DateTime   @default(now())

  @@index([deploymentId, createdAt])
  @@index([deploymentId, step, createdAt])
}

/// Values are encrypted at rest (server/utils/crypto.ts) and never returned
/// to the client — only the key and target are ever readable.
model DeploymentEnvVar {
  id             String     @id @default(cuid())
  deploymentId   String
  deployment     Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  key            String
  encryptedValue String
  target         EnvTarget  @default(PREVIEW)
  createdAt      DateTime   @default(now())

  @@unique([deploymentId, key, target])
}

/// One AI Console conversation. Owned by exactly one user: every read and
/// write goes through services/chat-session-service.ts, which filters by
/// userId on the query itself rather than checking ownership afterwards.
model AiChatSession {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  selectedModelId String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AiChatMessage[]

  /// Repository the conversation is currently about, so "this repo" and
  /// "deploy the frontend" resolve without the user naming it again.
  activeRepoOwner   String?
  activeRepoName    String?
  activeBranch      String?
  activeServicePath String?
  activeDeploymentId String?
  activeServerId     String?
  latestRepairPlanId String?
  latestFailurePoint String?
  latestRecommendedAction String?

  agentRuns AgentRun[]
  stagingSessions StagingSession[]

  @@index([userId, updatedAt])
}

model RepairPlan {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  deploymentId String
  deployment Deployment       @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  status     RepairPlanStatus @default(DRAFT)

  failurePoint      String?
  lastSuccessfulStep String?
  likelyCause       String
  recommendedFix    String
  riskLevel         RepairRiskLevel
  approvalRequired  Boolean          @default(false)
  actionsJson       Json
  evidenceJson      Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, deploymentId, createdAt])
}

model AgentRun {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      AiChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  deploymentId String?
  deployment   Deployment? @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  agentName     String
  intent        String
  inputSummary  String
  outputSummary String
  status        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([deploymentId, createdAt])
}

model AiChatMessage {
  id        String        @id @default(cuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  provider  String?
  modelId   String?
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
}

/// Cloud credentials for one user. Secrets are stored encrypted only
/// (server/utils/crypto.ts); nothing here is safe to return to the client
/// as-is — go through toSafeConnection() in services/provider-connections.
model CloudProviderConnection {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       CloudProvider
  credentialType CredentialType @default(ACCESS_KEY)
  name           String
  defaultRegion  String

  // Identity returned by sts:GetCallerIdentity — display-safe, no secrets.
  awsAccountId String?
  awsArn       String?
  awsUserId    String?

  // Last 4 of the access key id, for the masked display in the UI.
  accessKeyLast4 String?

  encryptedAccessKeyId     String?
  encryptedSecretAccessKey String?

  status         ProviderConnectionStatus @default(PENDING)
  lastVerifiedAt DateTime?
  failureReason  String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  // Re-saving the same named connection updates it instead of piling up rows.
  @@unique([userId, provider, name])
  @@index([userId])
}
