# Neon PostgreSQL — copy to .env and fill in. Never commit real values.
# DATABASE_URL: pooled connection (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: unpooled connection, used by prisma migrate. Same host without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Mistral — https://console.mistral.ai (API Keys)
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_MODEL=mistral-medium-latest

# AWS credential encryption (AES-256-GCM). 32 random bytes, base64.
# Generate with: openssl rand -base64 32
AWS_CREDENTIAL_ENCRYPTION_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx="

# TisiOps-managed Vercel account. Server-side only — never exposed to the browser.
# Leave VERCEL_TOKEN empty to keep deployments as clearly-marked MVP placeholders.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_PREFIX=tisiops
NEXT_PUBLIC_APP_URL=http://localhost:3000
