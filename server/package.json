{
  "name": "@tisiops/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./auth": "./auth/index.ts",
    "./constants": "./constants/index.ts",
    "./db": "./db/prisma.ts",
    "./services/user": "./services/user-service.ts",
