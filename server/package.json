  "scripts": {
    "dev": "tsx watch --env-file=.env index.ts",
    "build": "prisma generate",
    "start": "tsx --env-file-if-exists=.env index.ts",
    "worker": "tsx --env-file-if-exists=.env workers/deployment.worker.ts",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "studio": "prisma studio",
    "check:crypto": "tsx utils/crypto.check.ts",
    "check:urls": "tsx services/vercel/url.check.ts",
    "typecheck": "tsc --noEmit",
    "check:n8n": "tsx services/n8n/n8n.check.ts",
    "check:postgres": "tsx services/postgres/postgres.check.ts",
    "check:aws": "tsx services/aws/aws.check.ts",
    "check:queue": "tsx queues/queue.check.ts",
    "check:registry": "tsx services/terraform/registry.check.ts",
    "check:agent": "tsx services/terraform/agent.check.ts",
    "check:agent-routing": "tsx --env-file=.env services/agents/routing.check.ts",
    "check:limits": "tsx services/ai/limits.check.ts",
    "check:lifecycle": "tsx services/deployments/lifecycle.check.ts",
    "check:intent": "tsx services/github/intent.check.ts",
    "check:templates": "tsx services/templates/templates.check.ts",
    "check:admin-templates": "tsx services/templates/admin-templates.check.ts",
    "check:template-builder": "tsx services/templates/template-builder.check.ts",
    "check:server-status": "tsx services/servers/server-status.check.ts",
    "check:monitoring": "tsx services/servers/monitoring-installer.check.ts",
    "check:metrics": "tsx services/servers/metrics-collector.check.ts",
    "check:monitoring-agent": "tsx services/agents/monitoring-health.check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1106.0",
    "@aws-sdk/client-sts": "^3.1106.0",
    "@clerk/express": "^2.1.52",
    "@clerk/nextjs": "^7.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.0.9",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "next": "16.2.6",
    "ssh2": "^1.17.0",
    "tar-stream": "^3.2.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/ssh2": "^1.15.5",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.4",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
