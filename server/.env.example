# Neon PostgreSQL — copy to .env and fill in. Never commit real values.
# DATABASE_URL: pooled connection (host contains "-pooler"), used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# DIRECT_URL: unpooled connection, used by prisma migrate. Same host without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Mistral — https://console.mistral.ai (API Keys)
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_MODEL=mistral-medium-latest

# TisiOps AI Gateway. Provider keys are server-side only.
AI_GATEWAY_ENABLED=true
AI_GATEWAY_DEFAULT_MODEL=mistral-default
AI_GATEWAY_ADMIN_EMAIL=parampreetsinghlall@gmail.com
GEMINI_API_KEY=
GROK_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=
AI_GATEWAY_FREE_DAILY_MESSAGES=30
AI_GATEWAY_FREE_DAILY_TOKENS=100000
AI_GATEWAY_RATE_LIMIT_PER_MINUTE=10

# AWS credential encryption (AES-256-GCM). 32 random bytes, base64.
# Generate with: openssl rand -base64 32
AWS_CREDENTIAL_ENCRYPTION_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx="

# TisiOps-managed Vercel account. Server-side only — never exposed to the browser.
# Leave VERCEL_TOKEN empty to keep deployments as clearly-marked MVP placeholders.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_PREFIX=tisiops
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browser SSH terminal gateway. Leave empty locally to use this API host.
# In production, point this at a long-running Node service, not Vercel/serverless.
TERMINAL_WS_URL=

# --- Managed n8n deployments (TisiOps-owned AWS account) ---
# Off unless this is exactly "true". When on, every signed-in user can create
# one managed n8n server on the TisiOps AWS account.
MANAGED_N8N_ENABLED=false

# Terraform reads these directly. Never sent to the browser, never logged.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Remote Terraform state. Without TF_STATE_BUCKET the worker falls back to
# local state and logs a warning — development only, since state on the
# worker's disk is lost with the worker.
TF_STATE_BUCKET=
TF_STATE_REGION=ap-south-1
TF_STATE_LOCK_TABLE=

# CIDR allowed to reach port 22 on a server while it is being provisioned. Set
# this when the worker sits behind a NAT gateway or a pool of workers shares one
# egress range — otherwise each worker discovers its own address. Left empty,
# the worker uses its own address, and falls back to 0.0.0.0/0 with a warning
# only when that cannot be determined.
PROVISIONING_SSH_CIDR=

# Set once DNS automation exists; until then the TisiOps subdomain option is
# offered as unavailable rather than silently failing.
TISIOPS_DNS_ZONE_ID=

# Worker poll interval in milliseconds.
WORKER_POLL_MS=7000

# --- Redis Cloud queue (BullMQ) ---
# Backend and worker only. Never expose to the frontend, and never define a
# NEXT_PUBLIC_REDIS_URL — that would ship the password to the browser.
# Use rediss:// for the TLS endpoint.
REDIS_URL=redis://default:<password>@<host>:<port>

# One job at a time by default. Terraform applies are the expensive thing here.
WORKER_CONCURRENCY=1

# --- OpenTelemetry MVP observability ---
# Off by default. When true, exports traces and metrics to an OTLP HTTP collector.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=tisiops-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=

# SigNoz self-hosted Docker. Self-hosted SigNoz does not need an ingestion key.
SIGNOZ_ENABLED=false
SIGNOZ_MODE=self_hosted
# Current SigNoz Foundry Docker defaults to 8080. Older Compose installs may use 3301.
SIGNOZ_DASHBOARD_URL=http://localhost:8080
SIGNOZ_OTLP_ENDPOINT=http://localhost:4318
SIGNOZ_INGESTION_KEY=
